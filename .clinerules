# Reverse Engineering Analysis Rules for Cline
# Place this file in your project root directory to enable reverse engineering capabilities

[tools]
# Enable essential tools for reverse engineering
run_terminal_cmd = true
grep_search = true
list_dir = true
read_file = true
search_replace = true
# Additional analysis tools
run_terminal_cmd = true
grep_search = true

[rules]
# Core safety rules for reverse engineering
no_build_unless_explicit = true  # Never run build commands unless --run-tests flag is set
no_test_execution = true         # No automatic test execution
only_static_analysis = true      # Prefer static analysis over runtime inspection

# Output organization
create_specifications_directly = true  # Create specifications folder directly when doing analysis
respect_file_limits = true             # Honor --file-limit and --max-file-size parameters

# Template integration
load_templates_from = "./prompts/"     # Path to reverse engineering templates
output_directory = "./specifications/" # Where to write analysis results

[slash-commands]
# Main reverse engineering command with all supported parameters
reverse-analyze = """
Parameter mapping for reverse engineering analysis:

--repo <path>                    => Target repository path (default: ".")
--round <0|1|2>                  => Analysis round: 0=R0(global), 1=R1(focused), 2=R2(convergence)
--level <levels>                 => C4 levels to analyze (0=context,1=container,2=component,3=code)
--focus <modules>                => Comma-separated list of modules to focus on (R1+)
--depth <number>                 => Call chain analysis depth (default: 2 for R0, 3-4 for R1+)
--exclude <patterns>             => Glob patterns to exclude (default: common exclusions)
--file-limit <number>            => Maximum files to analyze (default: 8000)
--max-file-size <size>           => Maximum file size (default: 1.5MB)
--timebox <limits>               => Time limits per phase (e.g., "structure=10m,api=10m")
--run-tests <boolean>            => Enable minimal testing (default: false)
--resume <checkpoint>            => Resume from previous analysis checkpoint
--read-only <boolean>            => Analysis only, no source modifications (default: true)
--output <path>                  => Output directory (default: "./specifications")

Usage examples in prompts:
- Basic scan: --round 0 --repo .
- Focused analysis: --round 1 --focus "auth,payment" --depth 3
- Resume analysis: --round 1 --focus "problematic" --resume "specifications/R2/checkpoint.json"
"""

[behavior]
# Guidance for when reverse engineering is appropriate
use_reverse_analysis_for = """
- Understanding legacy codebases
- Documenting system architecture
- Planning refactoring or modernization
- Identifying modification risks
- Onboarding new developers
- Assessing system complexity
"""

# When NOT to use reverse engineering
avoid_reverse_analysis_for = """
- Writing new code (use normal coding workflow)
- Debugging runtime issues (use debugging tools)
- Performance monitoring (use profilers)
- Security scanning (use security tools)
"""

# Quality assurance
always_include_confidence = true      # Mark analysis confidence levels
track_assumptions = true              # Document analysis assumptions
validate_findings = true              # Cross-reference findings between rounds

[template-integration]
# Enhanced template system for Frontier-Based Exploration
template_folder = "./prompts/"
core_roles = ["roles/explorer_skeleton_discovery.md", "roles/reflector_confidence_assessment.md", "roles/curator_frontier_management.md"]
workflows = ["workflows/bootstrap_exploration.md"]
memory_schema = "memory/memory_schema_and_formats.md"

read_templates_before_analysis = true
dynamic_workflow_selection = true      # Choose workflow based on exploration state
agent_role_assignment = true           # Assign appropriate agent for each analysis step

# Template guidance mapping - Now role-based instead of round-based
explorer_role = "Discovery agent - finds system skeleton and boundaries"
reflector_role = "Quality assurance - assesses confidence and identifies gaps"
curator_role = "Knowledge integration - maintains exploration frontier and memory"
bootstrap_workflow = "Initial exploration - establish foundational understanding"
memory_system = "Structured knowledge storage and retrieval system"

[frontier-system]
# New frontier-based exploration configuration
dynamic_phase_transitions = true       # Allow flexible phase movement instead of fixed R0-R2
agent_coordination = true              # Enable Explorer→Reflector→Curator workflow
memory_driven_decisions = true         # Use confidence scoring for exploration direction
frontier_aware_expansion = true        # Track exploration boundaries intelligently

# Context management
incremental_knowledge_building = true  # Build understanding progressively
confidence_driven_prioritization = true # Focus on high-value, low-confidence areas
frontier_conciousness = true           # Always aware of exploration boundaries
adaptive_technique_selection = true    # Switch techniques based on situation

# Memory system configuration
structured_memory_format = true        # Use YAML frontmatter for all memory entries
memory_consistency_validation = true   # Ensure accumulated knowledge coherence
relationship_tracking = true          # Maintain element interconnections
evidence_chain_preservation = true    # Track confidence justification over time

[strategies]
# Automatic strategy selection based on exploration context
exploration_strategies = ["Bootstrap", "CoverageDriven", "PriorityBased", "RiskFocused"]
strategy_selection_logic = """
- Bootstrap: When memory is empty or very sparse (<5 elements)
- CoverageDriven: When overall confidence distribution is uneven (<60% avg confidence)
- PriorityBased: When clear value differences exist (importance variance >0.3)
- RiskFocused: When high-risk elements dominate frontier (risk_score >0.7)
"""
